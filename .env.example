# Example environment file for the Containerized 3-Tier App.
#
# Copy this file to .env and adjust values as needed.
# NEVER commit real credentials to version control. .env is listed in .gitignore.

# Database settings (used by both PostgreSQL and the FastAPI backend)
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# Optional: override the full SQLAlchemy URL directly
# DATABASE_URL=postgresql+psycopg2://taskuser:changeme@db:5432/taskdb
